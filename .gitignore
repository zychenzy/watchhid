# macOS / IDE
.DS_Store
.idea/
*.xcuserstate
xcuserdata/

# Xcode / SwiftPM build products (keep local diagnostics off git)
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
.swiftpm/
Packages/

# Signing / secrets / local machine binding
*.mobileprovision
*.p12
*.pem
*.p8
*.cer
*.der
.env
.env.*
Config/Developer.xcconfig
Config/local_devices.env
scripts/local_devices.env
scripts/__pycache__/
**/__pycache__/
*.pyc

# Logs / captures / crash (diagnostic artifacts stay on disk, not in git)
*.log
*.ips
*.crash
crashlog-*.ips
*.sysdiagnose
*.png
*.jpg
*.jpeg
*.heic
*.mov
*.mp4

# keep official app icons in the repo even though other images are local-only
!Apps/**/AppIcon.appiconset/*.png
